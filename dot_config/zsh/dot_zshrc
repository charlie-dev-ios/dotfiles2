# インタラクティブシェルの設定本体

# ---- 履歴 ----
HISTFILE="${ZDOTDIR}/.zsh_history"
HISTSIZE=10000          # メモリ上に保持する履歴数
SAVEHIST=10000          # ファイルに保存する履歴数

setopt SHARE_HISTORY        # 複数のシェル間で履歴を共有
setopt HIST_IGNORE_ALL_DUPS # 重複したコマンドは古い方を削除
setopt HIST_IGNORE_SPACE    # 空白で始まるコマンドは履歴に残さない
setopt HIST_REDUCE_BLANKS   # 余分な空白を削除して記録
setopt EXTENDED_HISTORY     # 実行時刻も記録

# ---- ディレクトリ移動 ----
setopt AUTO_CD          # ディレクトリ名だけで cd
setopt AUTO_PUSHD       # cd 時に自動で pushd
setopt PUSHD_IGNORE_DUPS # 重複したディレクトリを履歴に積まない

# ---- 補完 ----
setopt NO_BEEP          # 補完候補がないときにビープを鳴らさない
setopt INTERACTIVE_COMMENTS # コマンドラインでも # コメントを許可

# 補完キャッシュを XDG ディレクトリに置く
autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
mkdir -p "${_zcompdump:h}"
compinit -d "$_zcompdump"

# 補完候補の選択をカーソルで行えるようにする
zstyle ':completion:*' menu select
# 大文字小文字を区別しない補完
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# ---- キーバインド ----
bindkey -e              # Emacs 風キーバインド

# ---- エイリアス (導入済みツールに置き換え) ----
if (( $+commands[eza] )); then
  export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"
  alias ls='eza --icons --group-directories-first'
  alias la='eza -la --icons --group-directories-first'
  alias tree='eza --tree --icons'
  alias ll="eza \
      --long \
      --color=always \
      --color-scale=all \
      --color-scale-mode=gradient \
      --icons \
      --hyperlink \
      --all \
      --ignore-glob=.git \
      --header \
      --time=modified \
      --git \
      --time-style='+%Y/%m/%d %H:%M' \
      --octal-permissions \
      --no-user"
fi
if (( $+commands[bat] )); then
  alias cat='bat'
fi
# ghq + fzf でクローン済みリポジトリ間を移動
if (( $+commands[ghq] )) && (( $+commands[fzf] )); then
  alias repo='cd "$(ghq list --full-path | fzf)"'
fi

# ---- プロンプト / ツール連携 ----
# starship: プロンプト
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
# mise: ランタイムバージョン管理
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# ---- ローカル / 端末固有設定の読み込み (リポジトリ管理外) ----
# 全端末共通のローカル / 秘匿設定
[[ -f "${ZDOTDIR}/.zshrc.local" ]] && source "${ZDOTDIR}/.zshrc.local"

# 端末プロファイルごとの設定 (会社用 / 私用)
#   会社用の端末では .zshrc.work に、私用の端末では .zshrc.personal に書く。
#   これらは chezmoi の create_ 属性で「無ければ作成・あれば中身を変更しない」
#   管理のため、端末ごとに独立し、中身はリポジトリに同期されない。
#   各端末では該当するファイルにだけ中身を書けばよい (もう一方は空のまま no-op)。
for _zsh_profile in work personal; do
  [[ -f "${ZDOTDIR}/.zshrc.${_zsh_profile}" ]] && source "${ZDOTDIR}/.zshrc.${_zsh_profile}"
done
unset _zsh_profile
