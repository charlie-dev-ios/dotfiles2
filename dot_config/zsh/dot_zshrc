# インタラクティブシェルの設定本体

# ---- 履歴 ----
HISTFILE="${ZDOTDIR}/.zsh_history"
HISTSIZE=10000          # メモリ上に保持する履歴数
SAVEHIST=10000          # ファイルに保存する履歴数

setopt SHARE_HISTORY        # 複数のシェル間で履歴を共有
setopt HIST_IGNORE_ALL_DUPS # 重複したコマンドは古い方を削除
setopt HIST_IGNORE_SPACE    # 空白で始まるコマンドは履歴に残さない
setopt HIST_REDUCE_BLANKS   # 余分な空白を削除して記録
setopt EXTENDED_HISTORY     # 実行時刻も記録

# ---- ディレクトリ移動 ----
setopt AUTO_CD          # ディレクトリ名だけで cd
setopt AUTO_PUSHD       # cd 時に自動で pushd
setopt PUSHD_IGNORE_DUPS # 重複したディレクトリを履歴に積まない

# ---- 補完 ----
setopt NO_BEEP          # 補完候補がないときにビープを鳴らさない
setopt INTERACTIVE_COMMENTS # コマンドラインでも # コメントを許可

# 補完キャッシュを XDG ディレクトリに置く
autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
mkdir -p "${_zcompdump:h}"
compinit -d "$_zcompdump"

# 補完候補の選択をカーソルで行えるようにする
zstyle ':completion:*' menu select
# 大文字小文字を区別しない補完
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# ---- キーバインド ----
bindkey -e              # Emacs 風キーバインド

# ---- エイリアス (導入済みツールに置き換え) ----
if (( $+commands[eza] )); then
  export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"
  alias ls='eza --icons --group-directories-first'
  alias la='eza -la --icons --group-directories-first'
  alias tree='eza --tree --icons'
  alias ll="eza \
      --long \
      --color=always \
      --color-scale=all \
      --color-scale-mode=gradient \
      --icons \
      --hyperlink \
      --all \
      --ignore-glob=.git \
      --header \
      --time=modified \
      --git \
      --time-style='+%Y/%m/%d %H:%M' \
      --octal-permissions \
      --no-user"
fi
if (( $+commands[bat] )); then
  alias cat='bat'
fi
# neovim を vi/vim として使う
if (( $+commands[nvim] )); then
  alias vi='nvim'
  alias vim='nvim'
fi
# ghq + fzf でクローン済みリポジトリ間を移動
if (( $+commands[ghq] )) && (( $+commands[fzf] )); then
  alias repo='cd "$(ghq list --full-path | fzf)"'
fi
# yazi: ファイラ。`yazi` ではなく `y` で起動するとシェル連携が有効になり、
# キーマップ (dot_config/yazi/keymap.toml) に従って Enter で今いるディレクトリ
# へ cd して終了、q は cd せず終了、e は neovim で開く、という挙動になる。
if (( $+commands[yazi] )); then
  function y() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# ---- プロンプト / ツール連携 ----
# starship: プロンプト
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
# mise: ランタイムバージョン管理
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi
# zoxide: 賢いディレクトリ移動 (z / zi で履歴ジャンプ・fzf 連携)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# ---- ローカル / 秘匿設定の読み込み (リポジトリ管理外) ----
# 端末固有・秘匿の設定はここに書く (会社用 PC ではここに業務用設定を入れる)。
# .zshrc.local は chezmoi の create_ 属性で「無ければ作成・あれば中身を変更しない」
# 管理のため、端末ごとに独立し、中身はリポジトリに同期されない。
[[ -f "${ZDOTDIR}/.zshrc.local" ]] && source "${ZDOTDIR}/.zshrc.local"
# .zshrc.work は業務用設定を分離して置くためのファイル (存在すれば読み込む)。
# .zshrc.local と同様にリポジトリ管理外なので、会社固有の設定はこちらへ書く。
[[ -f "${ZDOTDIR}/.zshrc.work" ]] && source "${ZDOTDIR}/.zshrc.work"

# ---- GitHub レートリミット対策 ----
# mise (aqua バックエンド) と Homebrew は GitHub の API/Releases を叩くため、
# 未認証だと 60 req/時 で頭打ちになり `rate limit exceeded` を踏みやすい。
# .zshrc.local に `export GITHUB_TOKEN=...` を1つ置けば、ここで各ツール用の
# 環境変数へ展開して認証付きアクセス (5000 req/時) にする。トークン自体は
# .zshrc.local (非同期) にだけ書くので、リポジトリには push されない。
#   - mise     : GITHUB_TOKEN を直接尊重する (追加設定不要)
#   - Homebrew : HOMEBREW_GITHUB_API_TOKEN を見るので GITHUB_TOKEN から展開する
# 単にレート上限を上げるだけならトークンに scope は不要 (空 scope で可)。
# 既に個別に設定済みの場合はそちらを優先する (上書きしない)。
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  export HOMEBREW_GITHUB_API_TOKEN="${HOMEBREW_GITHUB_API_TOKEN:-$GITHUB_TOKEN}"
fi
